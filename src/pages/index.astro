---
import type { CollectionEntry } from "astro:content";
import PostCard from "@components/PostCard.astro";
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts, getTagList } from "../utils/content-utils";
import { getPostUrlBySlug, getTagUrl } from "../utils/url-utils";

const allBlogPosts = await getSortedPosts();
const uploadedCount = allBlogPosts.length;
const categoryCount = new Set(
	allBlogPosts.map((post) => post.data.category || "Chưa phân loại"),
).size;
const platformCount = new Set(
	allBlogPosts.map((post) => post.data.platform).filter(Boolean),
).size;

const tags = await getTagList();
---

<MainGridLayout hideSidebar={true}>
    <section class="card-base mb-4 overflow-hidden">
        <div class="grid gap-0 xl:grid-cols-[1.15fr_0.85fr]">
            <div class="px-6 py-6 md:px-8 md:py-8">
                <div class="mb-5 flex flex-wrap items-center gap-3 text-sm text-50">
                    {profileConfig.role && (
                        <span class="inline-flex items-center gap-2 rounded-lg bg-black/5 px-3 py-2 dark:bg-white/10">
                            <Icon name="material-symbols:badge-outline-rounded" class="text-lg text-[var(--primary)]" />
                            {profileConfig.role}
                        </span>
                    )}
                    {profileConfig.location && (
                        <span class="inline-flex items-center gap-2 rounded-lg bg-black/5 px-3 py-2 dark:bg-white/10">
                            <Icon name="material-symbols:location-on-outline-rounded" class="text-lg text-[var(--primary)]" />
                            {profileConfig.location}
                        </span>
                    )}
                </div>

                <h1 class="text-3xl font-bold text-90 md:text-4xl">{profileConfig.name}</h1>
                {profileConfig.bio && <p class="mt-3 max-w-2xl text-base leading-7 text-75">{profileConfig.bio}</p>}

                <div class="mt-6 grid gap-3 sm:grid-cols-3">
                    <div class="rounded-lg bg-black/[0.04] px-4 py-3 dark:bg-white/[0.08]">
                        <p class="text-sm text-50">Uploaded</p>
                        <p class="mt-1 text-2xl font-bold text-90">{uploadedCount}</p>
                    </div>
                    <div class="rounded-lg bg-black/[0.04] px-4 py-3 dark:bg-white/[0.08]">
                        <p class="text-sm text-50">Categories</p>
                        <p class="mt-1 text-2xl font-bold text-90">{categoryCount}</p>
                    </div>
                    <div class="rounded-lg bg-black/[0.04] px-4 py-3 dark:bg-white/[0.08]">
                        <p class="text-sm text-50">Platforms</p>
                        <p class="mt-1 text-2xl font-bold text-90">{platformCount}</p>
                    </div>
                </div>
            </div>

            <div class="border-t border-black/10 px-6 py-6 dark:border-white/10 md:px-8 xl:border-l xl:border-t-0">
                <div class="mb-5">
                    <h2 class="mb-3 text-lg font-bold text-90">Những thứ mình thích</h2>
                    <div class="flex flex-wrap gap-2">
                        {(profileConfig.interests ?? []).map((item) => (
                            <span class="rounded-lg border border-black/10 bg-black/5 px-3 py-2 text-sm font-medium text-[var(--primary)] dark:border-white/10 dark:bg-white/10">{item}</span>
                        ))}
                    </div>
                </div>

                <div class="mb-5">
                    <h2 class="mb-3 text-lg font-bold text-90">Tags</h2>
                    <div class="flex flex-wrap gap-2">
                        {tags.map((t) => (
                            <a
                                href={getTagUrl(t.name)}
                                aria-label={`View all posts with the ${t.name.trim()} tag`}
                                class="rounded-lg border border-black/10 bg-black/5 px-3 py-2 text-sm font-medium text-[var(--primary)] transition hover:bg-black/10 dark:border-white/10 dark:bg-white/10 dark:hover:bg-white/20"
                            >
                                {t.name.trim()}
                                <span class="ml-1 text-50 opacity-70">{t.count}</span>
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="post-list" class="card-base mb-4 px-4 py-4 md:px-6 md:py-5">
        <div class="mb-4 flex flex-wrap items-center gap-2">
            <span class="text-sm font-semibold text-50">Sắp xếp theo:</span>
            <div class="flex flex-wrap gap-2">
                <button type="button" data-sort-key="published" class="sort-btn sort-active btn-regular rounded-lg px-3 py-2 text-sm font-semibold">
                    Ngày <span class="sort-arrow">↓</span>
                </button>
                <button type="button" data-sort-key="category" class="sort-btn btn-regular rounded-lg px-3 py-2 text-sm font-semibold">
                    Danh mục <span class="sort-arrow"></span>
                </button>
                <button type="button" data-sort-key="platform" class="sort-btn btn-regular rounded-lg px-3 py-2 text-sm font-semibold">
                    Nền tảng <span class="sort-arrow"></span>
                </button>
            </div>
        </div>

        <div class="flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4 mb-4">
            {allBlogPosts.map((entry: CollectionEntry<"posts">, index: number) => (
                <div
                    class="post-item"
                    data-published={new Date(entry.data.published).valueOf()}
                    data-category={(entry.data.category || "Chưa phân loại").toLowerCase()}
                    data-platform={(entry.data.platform || "").toLowerCase()}
                >
                    <PostCard
                        entry={entry}
                        title={entry.data.title}
                        tags={entry.data.tags}
                        category={entry.data.category}
                        published={entry.data.published}
                        updated={entry.data.updated}
                        url={getPostUrlBySlug(entry.slug)}
                        image={entry.data.image}
                        description={entry.data.description}
                        draft={entry.data.draft}
                        class="onload-animation"
                        style={`animation-delay: calc(var(--content-delay) + ${index * 50}ms);`}
                    ></PostCard>
                </div>
            ))}
        </div>

        <div class="mt-4 flex flex-row justify-center gap-3">
            <button id="page-first" type="button" aria-label="First Page" class="btn-card flex h-11 w-11 items-center justify-center overflow-hidden rounded-lg text-[var(--primary)]">
                <Icon name="material-symbols:keyboard-double-arrow-left-rounded" class="text-[1.5rem]" />
            </button>
            <button id="page-prev" type="button" aria-label="Previous Page" class="btn-card flex h-11 w-11 items-center justify-center overflow-hidden rounded-lg text-[var(--primary)]">
                <Icon name="material-symbols:chevron-left-rounded" class="text-[1.75rem]" />
            </button>
            <div id="page-numbers" class="flex flex-row items-center rounded-lg bg-[var(--card-bg)] font-bold text-neutral-700 dark:text-neutral-300"></div>
            <button id="page-next" type="button" aria-label="Next Page" class="btn-card flex h-11 w-11 items-center justify-center overflow-hidden rounded-lg text-[var(--primary)]">
                <Icon name="material-symbols:chevron-right-rounded" class="text-[1.75rem]" />
            </button>
            <button id="page-last" type="button" aria-label="Last Page" class="btn-card flex h-11 w-11 items-center justify-center overflow-hidden rounded-lg text-[var(--primary)]">
                <Icon name="material-symbols:keyboard-double-arrow-right-rounded" class="text-[1.5rem]" />
            </button>
        </div>
    </section>

    <script is:inline>
        (function () {
            const items = Array.from(document.querySelectorAll(".post-item")).map((el) => ({
                el,
                published: Number(el.dataset.published),
                category: el.dataset.category || "",
                platform: el.dataset.platform || "",
            }));
            const pageSize = 8;
            let currentPage = 1;
            let sortKey = "published";
            let sortDir = "desc";

            function compare(a, b) {
                if (sortKey === "published") {
                    return sortDir === "asc" ? a.published - b.published : b.published - a.published;
                }
                const av = a[sortKey];
                const bv = b[sortKey];
                if (av < bv) return sortDir === "asc" ? -1 : 1;
                if (av > bv) return sortDir === "asc" ? 1 : -1;
                return 0;
            }

            function render() {
                const sorted = [...items].sort(compare);
                const lastPage = Math.max(1, Math.ceil(sorted.length / pageSize));
                currentPage = Math.min(Math.max(1, currentPage), lastPage);
                const start = (currentPage - 1) * pageSize;
                const end = start + pageSize;
                sorted.forEach((item, idx) => {
                    item.el.style.order = String(idx);
                    item.el.style.display = idx >= start && idx < end ? "" : "none";
                });
                renderPageNumbers(lastPage);
                document.getElementById("page-first")?.classList.toggle("disabled", currentPage === 1);
                document.getElementById("page-prev")?.classList.toggle("disabled", currentPage === 1);
                document.getElementById("page-next")?.classList.toggle("disabled", currentPage === lastPage);
                document.getElementById("page-last")?.classList.toggle("disabled", currentPage === lastPage);
            }

            function renderPageNumbers(lastPage) {
                const container = document.getElementById("page-numbers");
                if (!container) return;
                container.innerHTML = "";
                const ADJ_DIST = 2;
                const VISIBLE = ADJ_DIST * 2 + 1;
                let l = currentPage;
                let r = currentPage;
                let count = 1;
                while (l - 1 > 0 && r + 1 <= lastPage && count + 2 <= VISIBLE) {
                    count += 2; l--; r++;
                }
                while (l - 1 > 0 && count < VISIBLE) { count++; l--; }
                while (r + 1 <= lastPage && count < VISIBLE) { count++; r++; }

                const pages = [];
                if (l > 1) pages.push(1);
                if (l === 3) pages.push(2);
                if (l > 3) pages.push("...");
                for (let i = l; i <= r; i++) pages.push(i);
                if (r < lastPage - 2) pages.push("...");
                if (r === lastPage - 2) pages.push(lastPage - 1);
                if (r < lastPage) pages.push(lastPage);

                pages.forEach((p) => {
                    if (p === "...") {
                        const span = document.createElement("span");
                        span.className = "mx-1 flex items-center text-50";
                        span.textContent = "…";
                        container.appendChild(span);
                        return;
                    }
                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.textContent = String(p);
                    btn.className =
                        p === currentPage
                            ? "flex h-11 w-11 items-center justify-center rounded-lg bg-[var(--primary)] font-bold text-white dark:text-black/70"
                            : "btn-card flex h-11 w-11 items-center justify-center overflow-hidden rounded-lg active:scale-[0.85]";
                    btn.addEventListener("click", () => {
                        currentPage = p;
                        render();
                        document.getElementById("post-list")?.scrollIntoView({ behavior: "smooth", block: "start" });
                    });
                    container.appendChild(btn);
                });
            }

            document.getElementById("page-first")?.addEventListener("click", () => { currentPage = 1; render(); });
            document.getElementById("page-prev")?.addEventListener("click", () => { currentPage -= 1; render(); });
            document.getElementById("page-next")?.addEventListener("click", () => { currentPage += 1; render(); });
            document.getElementById("page-last")?.addEventListener("click", () => { currentPage = Number.POSITIVE_INFINITY; render(); });

            document.querySelectorAll("[data-sort-key]").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const key = btn.getAttribute("data-sort-key");
                    if (sortKey === key) {
                        sortDir = sortDir === "asc" ? "desc" : "asc";
                    } else {
                        sortKey = key;
                        sortDir = key === "published" ? "desc" : "asc";
                    }
                    currentPage = 1;
                    document.querySelectorAll("[data-sort-key]").forEach((b) => {
                        const isActive = b === btn;
                        b.classList.toggle("sort-active", isActive);
                        const arrow = b.querySelector(".sort-arrow");
                        if (arrow) arrow.textContent = isActive ? (sortDir === "asc" ? "↑" : "↓") : "";
                    });
                    render();
                });
            });

            render();
        })();
    </script>

    <style>
        .sort-btn.sort-active {
            background: var(--primary);
            color: #fff;
        }
        :global(.dark) .sort-btn.sort-active {
            color: rgba(0, 0, 0, 0.7);
        }
    </style>
</MainGridLayout>